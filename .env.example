# Google AI Studio API key (free tier): https://aistudio.google.com/apikey
# Server-side only — never prefix with VITE_.
GEMINI_API_KEY=

# Optional. Defaults to gemini-flash-latest.
GEMINI_MODEL=gemini-flash-latest

# Optional. MINIMAL | LOW | MEDIUM | HIGH | default (model's own setting). Defaults to LOW for faster first tokens.
GEMINI_THINKING_LEVEL=LOW

# Optional. Port for the local API dev server (Vite proxies /api here).
API_PORT=3001
