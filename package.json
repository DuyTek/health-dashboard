{
	"name": "health-insight-dashboard",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "concurrently -n web,api -c blue,magenta \"vite\" \"npm:dev:api\"",
		"dev:web": "vite",
		"dev:api": "tsx watch --env-file-if-exists=.env server/dev-server.ts",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"typecheck": "tsc -b --noEmit",
		"lint": "oxlint --deny-warnings",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"check": "npm run typecheck && npm run lint && npm run format:check && npm test"
	},
	"dependencies": {
		"@fontsource-variable/geist": "^5.3.0",
		"@google/adk": "^2.3.0",
		"@reduxjs/toolkit": "^2.13.0",
		"@tailwindcss/vite": "^4.3.3",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.5.0",
		"lucide-react": "^1.61.0",
		"radix-ui": "^1.8.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-markdown": "^10.1.0",
		"react-redux": "^9.3.0",
		"recharts": "^3.8.0",
		"remark-gfm": "^4.0.1",
		"shadcn": "^4.22.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.8",
		"@types/node": "^24.19.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vercel/node": "^27.0.1",
		"@vitejs/plugin-react": "^6.1.2",
		"concurrently": "^10.0.6",
		"dotenv": "^18.0.9",
		"jsdom": "^29.1.1",
		"oxlint": "^1.88.0",
		"prettier": "^3.9.10",
		"tsx": "^4.23.15",
		"typescript": "~6.0.3",
		"vite": "^8.3.4",
		"vitest": "^5.0.5"
	},
	"engines": {
		"node": ">=22"
	}
}
